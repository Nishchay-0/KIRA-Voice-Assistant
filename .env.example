# KIRA AI Voice Assistant - Environment Variables Configuration Template
# Copy this file to .env and customize values as needed. NEVER commit .env to GitHub.

# Python Runtime Configuration
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Locale & Encoding
LC_ALL=C.UTF-8
LANG=C.UTF-8

# Audio & Sound Server Configuration (For Docker / PulseAudio)
# Linux Local: /dev/snd
# Windows Docker PulseAudio: tcp:host.docker.internal:4713
# macOS PulseAudio: docker.for.mac.host.internal
PULSE_SERVER=unix:/tmp/pulseaudio.socket

# Voice Assistant Engine Settings
KIRA_DEFAULT_LANGUAGE=hi-IN
KIRA_DEFAULT_VOICE=en-IN-NeerjaNeural
KIRA_STT_ENGINE=auto
KIRA_WAKE_WORD=kira
